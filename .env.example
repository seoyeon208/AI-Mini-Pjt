# Copy to .env. Never commit real keys or conversation data.
# fake runs without a model API; choose ollama for local model inference.
LLM_BACKEND=fake
SUPERVISOR_VERSION=v2
OLLAMA_FAST_MODEL=qwen3.5:2b
OLLAMA_QUALITY_MODEL=qwen3:8b

# Optional paid OpenAI backend
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o

# External tracing is disabled by default. Enabling it sends request data externally.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=ops-desk
LANGSMITH_PROJECT=ops-desk
